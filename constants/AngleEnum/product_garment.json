            "valueMeanings": {
                "partial": "Only a portion of the product needs to be visible.",
                "primary_zones_only": "Only the commercially important zones need to be visible.",
                "mostly_visible": "Most of the product should be visible; minor cropping or obstruction is acceptable.",
                "fully_visible": "The complete product must be visible.",
                "fully_visible_with_context": "The complete product must be visible along with styling context around it."
            }
