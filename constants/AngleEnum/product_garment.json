        "fitVisibilityRequirement": {
            "type": "string",
            "description": "How clearly the garment fit and silhouette must be readable.",
            "possibleValues": [
                "none",
                "low",
                "medium",
                "high",
                "critical"
            ],
            "valueMeanings": {
                "none": "Fit does not need to be evaluated in this shot.",
                "low": "Fit may be partially visible but is not the main purpose.",
                "medium": "Fit should be reasonably readable, but minor obstruction is acceptable.",
                "high": "Fit must be clearly readable across the important garment zones.",
                "critical": "Fit is the primary purpose of the shot; obstruction or ambiguity should fail QC."
            }
        },
        "detailVisibilityRequirement": {
            "type": "string",
            "description": "How clearly garment details must be visible.",
            "possibleValues": [
                "none",
                "low",
                "medium",
                "high",
                "critical"
            ],
            "valueMeanings": {
                "none": "Details are irrelevant for this shot.",
                "low": "Details may appear but do not need to be clearly inspected.",
                "medium": "Major details should be visible at a normal catalog level.",
                "high": "Important details must be clearly visible and not obscured.",
                "critical": "The shot exists mainly to show details; missing details should fail QC."
            }
        },
        "layerVisibilityRequirement": {
            "type": "string",
            "description": "How clearly outfit layers must be visible.",
            "possibleValues": [
                "none",
                "low",
                "medium",
                "high",
                "critical"
            ],
            "valueMeanings": {
                "none": "Layering is not relevant.",
                "low": "Layering may be visible but is not important.",
                "medium": "Main layers should be understandable.",
                "high": "All visible layers should be clearly readable.",
                "critical": "Layering is a primary purpose of the shot and must be unambiguous."
            }
        },
        "productVisibilityRequirement": {
            "type": "string",
            "description": "How completely the actual product must be visible.",
            "possibleValues": [
