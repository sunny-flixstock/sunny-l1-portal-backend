# Server
PORT=7015

# MongoDB
DB_CONNECTION_STRING=
DB_USER=
DB_PASSWORD=

# AWS S3
s3AccessKey=
s3SecretKey=
s3Bucket=
promptS3Bucket=
s3Region=

# PostgreSQL (pgVector)
PG_DATABASE_URL=asset_vectors
# LLM providers
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3-flash-preview
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Partner API (comma-separated keys)
PARTNER_API_KEYS=

# Session auth (Google OAuth) -- required in every environment, this app
# has no unauthenticated mode. See gtom-ui/.env.example for the matching
# frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
ALLOWED_LOGIN_EMAIL=
SESSION_JWT_SECRET=
