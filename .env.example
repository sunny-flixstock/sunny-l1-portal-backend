# Server
PORT=7015

# MongoDB
DB_CONNECTION_STRING=
DB_USER=
DB_PASSWORD=

# AWS S3 -- required for the app to boot (an unrelated existing feature,
# asset management, checks these at startup) but NOT used anywhere in the
# L1 Feedback flow, which stores images directly in Mongo instead. Any
# non-empty placeholder value is fine for a deployment that only uses L1
# Feedback -- these are never called against a real bucket in that case.
s3AccessKey=unused
s3SecretKey=unused
s3Bucket=unused
promptS3Bucket=
s3Region=us-east-1

# PostgreSQL (pgVector) -- unused by L1 Feedback, leave blank
PG_DATABASE_URL=

# LLM providers -- L1 Feedback (RCA diagnosis, Generic Feedback diagnosis,
# and edit-apply) is driven by L1_RCA_PROVIDER/L1_RCA_MODEL below, not by
# provider-specific defaults here.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Which LLM the L1 Feedback flow uses (RCA diagnosis, Generic Feedback
# diagnosis, and applying an approved edit all read this). Set provider to
# "google" to use GEMINI_API_KEY above, or "anthropic" to use
# ANTHROPIC_API_KEY.
L1_RCA_PROVIDER=
L1_RCA_MODEL=

# Partner API (comma-separated keys)
PARTNER_API_KEYS=

# Phoenix telemetry server -- source for the one-click BZT Sports auto-run
# (POST /l1-feedback/auto-run). Bucket below is nanostudio's own artifact
# store (prompts/output images the auto-run reads), separate from s3Bucket
# above -- reuses the same s3AccessKey/s3SecretKey; confirm those
# credentials actually have read access to this bucket before relying on it.
PHOENIX_BASE_URL=http://192.168.12.115:6007
NANOSTUDIO_ARTIFACTS_BUCKET=ai-log-tracking

# Feedback-deck email (auto-run only) -- Gmail/Google Workspace SMTP, NOT
# AWS SES, per explicit instruction. SMTP_USER/SMTP_PASS authenticate as
# sunny.raj@flixstock.com: generate an App Password at
# Google Account -> Security -> App Passwords and put it in SMTP_PASS
# (not the real account password). Host/port default to Gmail's if unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sunny.raj@flixstock.com
SMTP_PASS=
SMTP_FROM=sunny.raj@flixstock.com

# Session auth (single shared password) -- required in every environment,
# this app has no unauthenticated mode.
PORTAL_PASSWORD=
SESSION_JWT_SECRET=
