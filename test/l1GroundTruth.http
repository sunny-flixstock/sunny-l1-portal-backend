@baseUrl = http://localhost:7015/api/v1
@authToken = paste-a-token-from-auth.http-here

### Seed the 8 BZT ground-truth documents from L1_Feedback_Skill/*.md (idempotent)
POST {{baseUrl}}/l1-feedback/ground-truth/seed HTTP/1.1
Authorization: Bearer {{authToken}}

### List ground-truth documents
GET {{baseUrl}}/l1-feedback/ground-truth?client=BZT HTTP/1.1
Authorization: Bearer {{authToken}}

### Get one document
GET {{baseUrl}}/l1-feedback/ground-truth/{{documentId}} HTTP/1.1
Authorization: Bearer {{authToken}}

### List a document's version history
GET {{baseUrl}}/l1-feedback/ground-truth/{{documentId}}/versions HTTP/1.1
Authorization: Bearer {{authToken}}

### Get one version's content
GET {{baseUrl}}/l1-feedback/ground-truth/versions/{{versionId}} HTTP/1.1
Authorization: Bearer {{authToken}}

### Promote a version to live
POST {{baseUrl}}/l1-feedback/ground-truth/{{documentId}}/promote HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "versionId": "{{versionId}}"
}

### Overwrite live+staging content with an out-of-band copy (e.g. the real
### current production styling.md/posing.md)
POST {{baseUrl}}/l1-feedback/ground-truth/{{documentId}}/refresh-content HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "content": "# Styling Rules — BZT Female Sports\n...",
  "createdBy": "production-refresh"
}

### Reset every ground-truth document to a clean v1 built from current Live,
### and wipe all L1FeedbackBatch/L1SkuTrace/L1GenericFeedbackRequest history.
### Irreversible.
POST {{baseUrl}}/l1-feedback/ground-truth/reset HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "confirm": true
}

### Reset only the 4 styling/posing docs to a clean v1 built from the real
### production .md files on disk. Does NOT touch feedback/batch history --
### any already-decided target pointing at one of these 4 docs is reopened
### to pending so it can be re-judged against the new v1.
POST {{baseUrl}}/l1-feedback/ground-truth/reset-styling-posing-v1 HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "confirm": true
}

### Seal the current staging draft into its own permanent version number
### and open a fresh draft at the same content. Approvals never advance the
### version number themselves -- this is the only thing that does.
POST {{baseUrl}}/l1-feedback/ground-truth/{{documentId}}/advance-staging HTTP/1.1
Authorization: Bearer {{authToken}}

### Same, for every document that currently has pending staging changes
### (or pass { "documentIds": [...] } to scope it) -- the common case of one
### run touching several ground-truth files at once.
POST {{baseUrl}}/l1-feedback/ground-truth/advance-staging-bulk HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{}
